# ==========================================
# SEGURIDAD Y CRIPTOGRAFÍA INTERLOCAPP
# ==========================================
JWT_SECRET="interlocapp-jwt-secret-key-2026-production-grade-coop"
TICKET_SIGNING_SECRET="interlocapp-ticket-hmac-sha256-secret-key-2026"

# ==========================================
# WEBSOCKET REALTIME (PUSHER CHANNELS / SOKETI)
# ==========================================
PUSHER_APP_ID="1234567"
PUSHER_KEY="tu_pusher_key"
PUSHER_SECRET="tu_pusher_secret"
PUSHER_CLUSTER="us2"
NEXT_PUBLIC_PUSHER_KEY="tu_pusher_key"
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

#
# CONFIGURACIÓN WEB PUSH (VAPID)
#
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@interlocapp.com

# ==========================================
# SERVICIO DE CORREO ELECTRÓNICO (BREVO)
# ==========================================
# Opción 1: Brevo HTTP API v3 (Recomendada - Puerto 443 HTTPS, evita bloqueos SMTP)
BREVO_API_KEY="xkeysib-tu_api_key_de_brevo"
BREVO_SENDER_NAME="InterlocApp"
BREVO_SENDER_EMAIL="interlocapp2026@gmail.com"
SMTP_FROM="InterlocApp <interlocapp2026@gmail.com>"

# Opción 2: Brevo SMTP Relay (Respaldo / Alternativa SMTP)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="tu_login_smtp_brevo"
SMTP_PASS="tu_clave_smtp_brevo"

# Modo Pruebas / Desarrollo: Simula envíos sin disparar correos reales
# DISABLE_EMAIL_SENDING="true"
